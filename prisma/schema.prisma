// Database schema. Film metadata is cached from TMDB; everything else is user data.
// After editing: `npx prisma migrate dev --name <change>`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String?
  bio          String?
  location     String?
  website      String?
  // Up to four TMDB film ids shown on the profile, in order.
  favoriteFilmIds Int[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  statuses   FilmStatus[]
  entries    LogEntry[]
  watchlist  WatchlistItem[]
  lists      List[]
  following  Follow[]     @relation("follower")
  followers  Follow[]     @relation("following")
  entryLikes EntryLike[]
  listLikes  ListLike[]
  comments   Comment[]
}

// Film metadata cached from TMDB. `id` is the TMDB movie id.
model Film {
  id            Int       @id
  title         String
  originalTitle String?
  releaseDate   DateTime?
  year          Int?
  overview      String?
  tagline       String?
  runtime       Int?
  posterPath    String?
  backdropPath  String?
  genres        String[]  @default([])
  directors     String[]  @default([])
  // Top-billed cast: [{ name, character }]
  cast          Json?
  fetchedAt     DateTime  @default(now())

  statuses  FilmStatus[]
  entries   LogEntry[]
  watchlist WatchlistItem[]
  listItems ListItem[]

  @@index([title])
}

// A member's current relationship with a film, independent of diary entries.
model FilmStatus {
  userId    String
  filmId    Int
  watched   Boolean  @default(false)
  liked     Boolean  @default(false)
  // Half-star scale stored as 1..10 (1 = ½★, 10 = ★★★★★). Null = unrated.
  rating    Int?
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([userId, filmId])
  @@index([filmId])
}

// A diary entry: one viewing, optionally with a review.
model LogEntry {
  id         String    @id @default(cuid())
  userId     String
  filmId     Int
  watchedOn  DateTime? @db.Date
  rating     Int?
  liked      Boolean   @default(false)
  rewatch    Boolean   @default(false)
  review     String?
  spoilers   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  film     Film        @relation(fields: [filmId], references: [id], onDelete: Cascade)
  likes    EntryLike[]
  comments Comment[]

  @@index([userId, watchedOn])
  @@index([filmId, createdAt])
  @@index([createdAt])
}

model WatchlistItem {
  userId  String
  filmId  Int
  addedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([userId, filmId])
}

model List {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  ranked      Boolean  @default(false)
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ListItem[]
  likes ListLike[]

  @@index([userId])
  @@index([createdAt])
}

model ListItem {
  listId   String
  filmId   Int
  position Int
  note     String?

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([listId, filmId])
  @@index([listId, position])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model EntryLike {
  userId    String
  entryId   String
  createdAt DateTime @default(now())

  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry LogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([userId, entryId])
  @@index([entryId])
}

model ListLike {
  userId    String
  listId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([userId, listId])
  @@index([listId])
}

model Comment {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  body      String
  createdAt DateTime @default(now())

  entry LogEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}
