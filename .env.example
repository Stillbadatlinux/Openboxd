# Copy to .env and fill in. Never commit .env.

# PostgreSQL. DATABASE_URL is what the app uses (pooled on Neon/Supabase);
# DATABASE_URL_UNPOOLED is the direct connection migrations use. Locally, both can be the same.
# On Vercel, the Neon integration sets both for you.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Signs session cookies. Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# TMDB API key (v3) or API Read Access Token (v4) from https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Optional: point at the mock server for offline development (npm run mock:tmdb)
# TMDB_API_BASE="http://127.0.0.1:4010/3"

# Optional: the site's name, shown in the header and page titles.
# NEXT_PUBLIC_SITE_NAME="Reelbook"
